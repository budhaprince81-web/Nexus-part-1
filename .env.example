# =============================================================================
# NEXUS AI OPERATING SYSTEM — environment template
# =============================================================================
# Copy the values you need into Replit Secrets (or a local, untracked .env).
# NEVER commit real credentials. The server reads these at request time, so
# after changing a secret you can press "reload" in Settings → AI Providers
# instead of restarting the service.
# =============================================================================

# --- Required ----------------------------------------------------------------
# Postgres connection string (Drizzle ORM + agent run history).
DATABASE_URL=postgresql://user:password@host:5432/nexus

# --- AI providers (configure AT LEAST ONE) -----------------------------------
# Any combination works. The engine picks the default, then falls back through
# the rest automatically. A key is only ever read server-side; it is never sent
# to the browser, logged, or returned by an API response.
#
# ANY provider variable may hold SEVERAL keys separated by commas. The engine
# rotates them automatically: if one is revoked, rate-limited or out of quota,
# the same request is retried with the next key before the provider is
# considered failed. Example:
#   OPENROUTER_API_KEY=sk-or-v1-aaaa,sk-or-v1-bbbb

# Anthropic (native Messages API)
ANTHROPIC_API_KEY=
# Optional model overrides — defaults: claude-haiku-4-5 / claude-sonnet-4-6 / claude-opus-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# ANTHROPIC_MODEL_REASONING=claude-opus-4-5

# Groq (OpenAI-compatible; fast open-weight models)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (OpenAI-compatible; many vendors behind one key)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional attribution headers
# OPENROUTER_SITE_URL=https://your-site.example
# OPENROUTER_SITE_NAME=NEXUS AI OS

# OpenAI (Chat Completions)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_REASONING=gemini-2.5-pro

# Local models via an Ollama-compatible server. Only used when the URL is set
# explicitly (a localhost default would otherwise look "configured" everywhere).
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2

# --- Data providers (optional; power research and market tools) ---------------
# Alpha Vantage — real market data for the Trading page and the market_data
# agent tool. Free tier allows ~25 requests/day, so results are cached and
# identical concurrent lookups are de-duplicated.
ALPHA_VANTAGE_API_KEY=
# ALPHA_VANTAGE_INTRADAY=false   # set true only if your plan includes intraday
# MARKET_QUOTE_TTL_MS=300000     # 5 min quote cache
# MARKET_SERIES_TTL_MS=3600000   # 1 h daily-series / FX cache
# MARKET_DAILY_BUDGET=24         # local safety ceiling on upstream calls per 24h
# Free keys allow ~1 request/second, so upstream calls are paced and a transient
# limit is retried. Raise/lower these only if your plan differs.
# MARKET_MIN_INTERVAL_MS=1100    # minimum gap between upstream calls (0 disables)
# MARKET_RATE_LIMIT_ROUNDS=3     # rounds attempted after a rate limit (1 = no retry)
# MARKET_RATE_LIMIT_BACKOFF_MS=1500

# NewsAPI — lets the Research agent ground answers in real, citable articles
# and gives the autonomous agent a news_search tool.
NEWS_API_KEY=
# NEWS_CACHE_TTL_MS=600000       # 10 min repeat-search cache

# --- Provider routing --------------------------------------------------------
# Force a specific default provider (anthropic | openai | groq | openrouter |
# gemini | ollama). Without this, the first configured provider wins.
# NEXUS_DEFAULT_PROVIDER=groq
# Ordered fallback chain, tried after the default fails.
# NEXUS_FALLBACK_PROVIDERS=anthropic,openrouter

# --- Engine tuning (all optional) --------------------------------------------
# Hard ceiling for one provider HTTP attempt.
# NEXUS_AI_TIMEOUT_MS=60000
# Retries for *transient* failures only (429/5xx/timeouts/network).
# NEXUS_AI_MAX_RETRIES=2
# NEXUS_AI_RETRY_BASE_MS=300
# NEXUS_AI_RETRY_MAX_MS=4000

# --- Development / simulation ------------------------------------------------
# Enables a clearly-labelled deterministic provider used for local testing when
# no real key is available. Every response it produces is marked SIMULATED, and
# it never counts as "AI available". Leave unset in production.
# NEXUS_ALLOW_MOCK_PROVIDER=false

# --- Server ------------------------------------------------------------------
# PORT=8080
# LOG_LEVEL=info
# Comma-separated hostnames allowed to reach the Vite dev/preview server.
# NEXUS_ALLOWED_HOSTS=localhost,127.0.0.1

# --- FastAPI service (optional secondary backend) ----------------------------
# The Python service lives in artifacts/api-server/fastapi and has its own
# .env.example with its own variables.
