modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

# `Project` is intentionally NOT defined as a workflow: leaving it undefined
# lets Replit run the app from the artifact definitions (nexus-ui on 19576 and
# the API server on 8080), which is what the frontend expects. Defining a
# `Project` workflow overrides the artifacts and previously made the Run button
# start only the FastAPI service, leaving the UI and /api routes unserved.
[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "NEXUS FastAPI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server/fastapi && bash scripts/dev.sh"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["postgresql", "redis"]
