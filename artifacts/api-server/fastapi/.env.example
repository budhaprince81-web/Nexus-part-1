APP_ENV=development
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexus
DATABASE_SCHEMA=nexus_python
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ANTHROPIC_API_KEY=
# Optional: override the Claude model used by the Python agents
ANTHROPIC_MODEL=claude-sonnet-5-5
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:19576
NEXUS_WORKSPACE=/tmp/nexus-workspace
